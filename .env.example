# MCPBox configuration. Copy to .env and edit. Every value has a safe default;
# an empty .env is valid.

# --- Network exposure -------------------------------------------------------
# SSH host binding. Keep 127.0.0.1 on a laptop. On a remote host that you reach
# over SSH, set 0.0.0.0 (and firewall the port).
MCPBOX_SSH_BIND=127.0.0.1
MCPBOX_SSH_PORT=22222
# The MCP port is ALWAYS bound to 127.0.0.1 in compose.yaml. Only the number
# is configurable. Remote clients use an SSH tunnel: ssh -N -L 33333:mcp:3000 ...
MCPBOX_MCP_PORT=33333
TZ=UTC

# --- Identity ---------------------------------------------------------------
# UID/GID of the in-container "agent" user (build-time). Match your host user if
# you deliberately bind mount host directories; otherwise leave alone.
MCPBOX_AGENT_UID=1000
MCPBOX_AGENT_GID=1000

# --- Workspace bootstrap ----------------------------------------------------
# Optional: clone a public or already-authenticated HTTPS repository once into
# the persistent workspace. Leave blank for an empty /workspace/project.
MCPBOX_REPO_URL=
# Optional repository-local Git identity.
MCPBOX_GIT_USER_NAME=
MCPBOX_GIT_USER_EMAIL=

# --- Container resource limits ---------------------------------------------
# Defaults suit a personal development machine: builds run, runaway loops do
# not take the host down. Raise them for heavy compilation.
MCPBOX_MCP_CPUS=2
MCPBOX_MCP_MEMORY=4g
MCPBOX_MCP_PIDS=1024
MCPBOX_WORKBENCH_CPUS=2
MCPBOX_WORKBENCH_MEMORY=4g
MCPBOX_WORKBENCH_PIDS=2048
MCPBOX_NOFILE=65536

# --- MCP server limits ------------------------------------------------------
# Max concurrently running exec_command sessions.
MCPBOX_MAX_SESSIONS=16
# Hard wall-clock limit per session (ms). 1 h.
MCPBOX_MAX_RUNTIME_MS=3600000
# Kill a running session nobody has polled/written to for this long (ms). 30 min.
MCPBOX_IDLE_TIMEOUT_MS=1800000
# SIGTERM -> SIGKILL grace period (ms).
MCPBOX_KILL_GRACE_MS=5000
# Unread output retained per session (chars); older output is dropped.
MCPBOX_MAX_BUFFER_CHARS=2000000
# view_image size cap (bytes). 12 MiB.
MCPBOX_MAX_IMAGE_BYTES=12582912
# Concurrent in-flight HTTP requests before returning 503.
MCPBOX_MAX_CONCURRENT_REQUESTS=32

# --- HTTP hardening ---------------------------------------------------------
# Comma-separated allow-lists. Hosts: value of the Host header (port ignored).
# Origins: full origins such as http://localhost:33333. Requests without an
# Origin header (curl, most MCP CLIs) are accepted; a present Origin must match.
MCPBOX_ALLOWED_HOSTS=127.0.0.1,localhost,mcp
MCPBOX_ALLOWED_ORIGINS=

# DEPRECATED compatibility: also accept the token in the URL path
# (http://127.0.0.1:33333/<token>/mcp) as the old ssh-mcp-four-tools-kit did.
# Prefer Authorization: Bearer <token> at /mcp. 0 = off.
MCPBOX_LEGACY_PATH_TOKEN=0
MCPBOX_LOG_LEVEL=info
